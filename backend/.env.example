# StockWell backend
PORT=4040
FRONTEND_URL=http://localhost:5173

# PayFast
# Use sandbox while testing, then switch to false for live payments.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase

# Public frontend URL PayFast redirects back to after checkout.
# Example production value: https://your-stockwell-site.example
PAYFAST_RETURN_BASE_URL=http://localhost:5173

# Public HTTPS URL PayFast can reach for ITN notifications.
# Localhost will NOT work for live PayFast callbacks unless exposed through a public tunnel.
# Example: https://your-api.example.com/api/pay/payfast/notify
PAYFAST_NOTIFY_URL=http://localhost:4040/api/pay/payfast/notify
